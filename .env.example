# ============================================================
# RehabilitAR - variables de entorno
# Copiar a ".env" (raiz del repo) y completar. NUNCA subir el .env real a GitHub.
# Las marcadas con [CAMBIAR] hay que actualizarlas con el proyecto NUEVO de Supabase.
# ============================================================

# --- Supabase (proyecto nuevo) ---------------------------------
# [CAMBIAR] Project Settings -> API -> Project URL
SUPABASE_URL=https://TU_REF.supabase.co
# [CAMBIAR] anon / publishable key
SUPABASE_KEY=tu-anon-key
# [CAMBIAR] service_role / secret key (solo backend, nunca en el frontend)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# [CAMBIAR] Project Settings -> JWT Keys / API -> JWT Secret
SUPABASE_JWT_SECRET=tu-jwt-secret

# --- Mercado Pago (no cambian con la migracion) -----------------
MERCADO_PAGO_ACCESS_TOKEN_TEST=tu-access-token-de-test
MP_EXTERNAL_POS_ID=id-de-tu-punto-de-venta

# --- Mail (Gmail, contrasena de aplicacion) ---------------------
acc_password=tu-contrasena-de-aplicacion

# --- URLs publicas ----------------------------------------------
# [CAMBIAR en produccion] Local: http://localhost:8000/frontend
# Railway: https://TU-APP.up.railway.app/frontend
FRONTEND_PUBLIC_URL=http://localhost:8000/frontend
# [CAMBIAR en produccion] Dominios permitidos por CORS, separados por coma.
# Local: dejar vacio. Railway: https://TU-APP.up.railway.app
ALLOWED_ORIGINS=

# --- Opcionales (intervalos de tareas en segundos, por defecto 900) ---
# NO_PROFESSOR_CANCELLATION_INTERVAL_SECONDS=900
# ATTENDANCE_REMINDER_INTERVAL_SECONDS=900
# NO_PROFESSOR_NOTIFICATION_INTERVAL_SECONDS=900
# DEBT_REMINDER_INTERVAL_SECONDS=900
# SUBSCRIPTION_DUE_SOON_INTERVAL_SECONDS=900
# SUBSCRIPTION_PAYMENT_EXPIRED_INTERVAL_SECONDS=900
